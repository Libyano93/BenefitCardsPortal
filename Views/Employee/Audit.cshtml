@model BenefitCardsPortal.Models.EmployeeAuditViewModel
@{ ViewData["Title"] = "سجل عمليات الموظفين"; }
<div class="page-heading"><span class="eyebrow">متابعة العمليات</span><h1 class="h2">سجل عمليات الموظفين</h1><p class="text-muted">آخر 500 عملية: رفع، تعديل، تسليم، اعتماد أو حذف.</p></div>
<form method="get" asp-action="Audit" class="filter-panel row g-2 align-items-end mb-3"><div class="col-sm-6 col-lg-3"><label class="form-label">نوع العملية</label><select class="form-select" name="actionName"><option value="">كل العمليات</option>@foreach (var action in new[] { "رفع دفعة", "تعديل سجل", "إضافة سجل", "تسجيل استلام", "إلغاء تسجيل الاستلام", "اعتماد دفعة", "حذف دفعة" }) { <option value="@action" selected="@(Model.Action == action)">@action</option> }</select></div><div class="col-sm-6 col-lg-3"><label class="form-label">الموظف</label><input class="form-control" name="employee" value="@Model.Employee" placeholder="اسم المستخدم أو البريد"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">من تاريخ</label><input class="form-control" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">إلى تاريخ</label><input class="form-control" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")"/></div><div class="col-lg-2 d-flex gap-2"><button class="btn btn-primary">تصفية</button><a asp-action="Audit" class="btn btn-light">مسح</a></div></form>
<div class="search-result-count mb-3"><span>عدد العمليات المعروضة (بحد أقصى 500)</span><strong>@Model.Events.Count</strong></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>التاريخ والوقت (ليبيا)</th><th>الموظف</th><th>العملية</th><th>الدفعة</th><th>السجل</th><th>التفاصيل</th></tr></thead><tbody>
@if (Model.Events.Count == 0) { <tr><td colspan="6" class="text-center py-5 text-muted">لا توجد عمليات مطابقة.</td></tr> }
@foreach (var entry in Model.Events) { <tr><td dir="ltr" class="text-end">@DateTime.SpecifyKind(entry.OccurredAtUtc, DateTimeKind.Utc).AddHours(2).ToString("yyyy-MM-dd HH:mm")</td><td>@entry.Actor</td><td><span class="status-pill status-done">@entry.Action</span></td><td>@(entry.BatchId?.ToString() ?? "—")</td><td>@(entry.RecordId?.ToString() ?? "—")</td><td>@entry.Summary</td></tr> }
</tbody></table></div></div>

