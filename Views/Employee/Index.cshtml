@model IReadOnlyList<BenefitCardsPortal.Models.BenefitBatch>
@{ ViewData["Title"] = "لوحة الموظف"; var total = Model.Sum(x => x.Records.Count); var received = Model.Sum(x => x.Records.Count(r => r.IsReceived)); var pending = total - received; var canDelete = User.IsInRole("BatchDeleter") || User.IsInRole("PortalAdmin"); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><span class="eyebrow">مركز إدارة الكشوف</span><h1 class="h2 mb-1">لوحة الموظف</h1><p class="text-muted mb-0">إحصاءات الدفعات ومتابعة البطاقات المستلمة.</p></div><div class="d-flex flex-wrap gap-2">@if (User.IsInRole("BatchUploader") || User.IsInRole("PortalAdmin")) { <a asp-action="Upload" class="btn btn-primary btn-lg">＋ رفع دفعة كشف</a> }<a asp-controller="Reports" asp-action="Index" class="btn btn-outline-success btn-lg">تقرير التسليمات</a><a asp-action="Audit" class="btn btn-outline-dark btn-lg">سجل العمليات</a>@if (User.IsInRole("CardReceiver") || User.IsInRole("PortalAdmin")) { <a asp-action="ReceiptReversals" class="btn btn-outline-danger btn-lg">تقرير إلغاء التسليم</a> }@if (User.IsInRole("PortalAdmin")) { <a asp-controller="EmployeeAccounts" asp-action="Create" class="btn btn-success btn-lg">＋ تسجيل موظف جديد</a> }</div></div>
@if (canDelete && ViewBag.DeletionEnabled != true) { <div class="alert alert-warning">زر الحذف يتطلب ضبط رمز منفصل في إعداد التشغيل: <code>BatchDeletion__Passcode</code>.</div> }
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="stat-card stat-violet"><span>إجمالي الدفعات</span><strong>@Model.Count</strong><small>كشف محفوظ في النظام</small></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card stat-blue"><span>البطاقات المسجلة</span><strong>@total</strong><small>في جميع الدفعات</small></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card stat-green"><span>تم استلامها</span><strong>@received</strong><small>بطاقة مسلّمة للمستفيد</small></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card stat-amber"><span>بانتظار الاستلام</span><strong>@pending</strong><small>بطاقة لم تُسلّم بعد</small></div></div>
</div>
<div class="row g-3 mb-4"><div class="col-lg-7"><section class="chart-card h-100"><div class="d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-1">حركة التسليم</h2><p class="text-muted small mb-0">مقارنة البطاقات المسلّمة والمتبقية</p></div><span class="chart-total">@total بطاقة</span></div><div class="delivery-chart" role="img" aria-label="تم استلام @received بطاقة، ولم يستلم @pending بطاقة"><div class="chart-bar-label"><span>تم الاستلام</span><strong>@received</strong></div><div class="chart-track"><div class="chart-fill chart-fill-green" style="width:@(total == 0 ? 0 : Math.Max(3, received * 100 / total))%"></div></div><div class="chart-bar-label"><span>لم يستلم</span><strong>@pending</strong></div><div class="chart-track"><div class="chart-fill chart-fill-amber" style="width:@(total == 0 ? 0 : Math.Max(3, pending * 100 / total))%"></div></div></div></section></div>
<div class="col-lg-5"><section class="chart-card h-100"><h2 class="h5">حالة الكشوف</h2><p class="text-muted small">مراجعة واعتماد الدفعات</p><div class="batch-chart" role="img" aria-label="@Model.Count(x => x.IsReviewed) دفعة معتمدة من أصل @Model.Count"><div class="batch-chart-ring @(Model.Count == 0 ? "chart-empty" : "")" style="--approved:@(Model.Count == 0 ? 0 : Model.Count(x => x.IsReviewed) * 100 / Model.Count)%"><div><strong>@Model.Count(x => x.IsReviewed)</strong><span>معتمد</span></div></div><div class="batch-chart-legend"><span><i class="approved-key"></i>معتمد <b>@Model.Count(x => x.IsReviewed)</b></span><span><i class="review-key"></i>قيد المراجعة <b>@Model.Count(x => !x.IsReviewed)</b></span></div></div></section></div></div>
<section class="filter-panel mb-3"><form method="get" asp-action="Index" class="row g-2 align-items-end"><div class="col-sm-4 col-lg-3"><label class="form-label">شهر الصلاحية</label><select name="month" class="form-select"><option value="">كل الأشهر</option>@for (var m=1;m<=12;m++){<option value="@m" selected="@(ViewBag.SelectedMonth == m)">@m</option>}</select></div><div class="col-sm-4 col-lg-3"><label class="form-label">السنة</label><select name="year" class="form-select"><option value="">كل السنوات</option>@foreach (var y in (IEnumerable<int>)ViewBag.Years){<option value="@y" selected="@(ViewBag.SelectedYear == y)">@y</option>}</select></div><div class="col-sm-4 col-lg-3"><label class="form-label">حالة الكشف</label><select name="status" class="form-select"><option value="all" selected="@((string)ViewBag.SelectedStatus == "all")">كل الحالات</option><option value="reviewed" selected="@((string)ViewBag.SelectedStatus == "reviewed")">معتمد</option><option value="pending" selected="@((string)ViewBag.SelectedStatus == "pending")">قيد المراجعة</option></select></div><div class="col-lg-3 d-flex gap-2"><button class="btn btn-primary">تصفية</button><a asp-action="Index" class="btn btn-light">مسح</a></div></form><div class="text-muted small mt-2">تظهر @Model.Count دفعة مطابقة للفلاتر الحالية.</div></section>
<section class="card border-0 shadow-sm"><div class="card-header bg-white border-0 px-4 pt-4"><h2 class="h5 mb-0">الكشوف المرفوعة</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>الشهر والسنة</th><th>الملف</th><th>السجلات</th><th>المراجعة</th><th>الإجراءات</th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="5" class="text-center py-5 text-muted">لا توجد دفعات بعد. ارفع أول كشف للبدء.</td></tr> }
@foreach (var batch in Model) { <tr><td class="fw-semibold">@batch.ValidityMonth/@batch.ValidityYear</td><td>@batch.SourceFileName</td><td><span class="count-chip">@batch.Records.Count سجل</span></td><td><span class="status-pill @(batch.IsReviewed ? "status-done" : "status-wait")">@(batch.IsReviewed ? "معتمد" : "قيد المراجعة")</span></td><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@batch.Id">مراجعة الدفعة</a>@if (canDelete && ViewBag.DeletionEnabled == true) { <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteBatchModal" data-batch-id="@batch.Id" data-batch-name="@batch.ValidityMonth/@batch.ValidityYear">حذف</button> }</div></td></tr> }
</tbody></table></div></section>
@if (ViewBag.DeletionEnabled == true) { <div class="modal fade" id="deleteBatchModal" tabindex="-1" aria-labelledby="deleteBatchTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0"><form asp-action="DeleteBatch" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" id="deleteBatchId"/><div class="modal-header"><h2 class="modal-title h5" id="deleteBatchTitle">تأكيد حذف الدفعة</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body"><p>سيتم حذف الدفعة <strong id="deleteBatchName"></strong> وسجلاتها نهائيًا. أدخل رمز الحذف للمتابعة.</p><label for="deletePasscode" class="form-label">رمز تأكيد الحذف</label><input class="form-control" id="deletePasscode" name="passcode" type="password" minlength="8" autocomplete="current-password" required /></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-danger">تأكيد الحذف</button></div></form></div></div></div> }
@section Scripts { <script>document.getElementById('deleteBatchModal')?.addEventListener('show.bs.modal', event => { const button = event.relatedTarget; document.getElementById('deleteBatchId').value = button.dataset.batchId; document.getElementById('deleteBatchName').textContent = button.dataset.batchName; document.getElementById('deletePasscode').value = ''; });</script> }
