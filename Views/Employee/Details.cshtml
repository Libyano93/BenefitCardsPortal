@model BenefitCardsPortal.Models.EmployeeBatchDetailsViewModel
@{ var batch = Model.Batch; var canEdit = ViewBag.CanEditCards == true; var canReceive = ViewBag.CanReceiveCards == true; var canApprove = ViewBag.CanApproveBatch == true; ViewData["Title"] = "مراجعة الدفعة"; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><span class="eyebrow">دفعة @batch.ValidityMonth/@batch.ValidityYear</span><h1 class="h2">مراجعة الكشف المستخرج</h1><p class="text-muted mb-0">@batch.SourceFileName · @Model.Records.Count من @batch.Records.Count سجل</p></div><div class="d-flex gap-2"><a asp-action="Preview" asp-route-id="@batch.Id" class="btn btn-primary">عرض الكشف داخل النظام</a><a asp-action="Download" asp-route-id="@batch.Id" class="btn btn-outline-secondary">تنزيل الكشف</a><a asp-action="Index" class="btn btn-light">العودة للكشوف</a></div></div>
<div class="alert alert-info">تظهر الحقول بترتيب عناوين كشف الوزارة. الإجراءات المتاحة هنا تعتمد على الصلاحيات التي منحها المسؤول لحسابك.</div>
@if (Model.Findings.Count > 0) { <section class="quality-panel mb-4"><h2 class="h5 mb-2">نتيجة الفحص الآلي · @Model.Findings.Sum(x => x.Count) ملاحظة</h2><p class="small text-muted">التكرار ونقص الاسم أو التسلسل يمنع اعتماد الدفعة حتى التصحيح. بقية التنبيهات للمراجعة البصرية.</p><ul class="mb-0">@foreach (var finding in Model.Findings) { <li><span class="@(finding.IsBlocking ? "text-danger fw-bold" : "text-warning-emphasis")">@(finding.IsBlocking ? "يلزم التصحيح" : "يرجى التحقق"):</span> @finding.Message — @finding.Count سجل</li> }</ul></section> }
<form method="get" asp-action="Details" class="filter-panel row g-2 align-items-end mb-3"><input type="hidden" name="id" value="@batch.Id"/><div class="col-md-5"><label class="form-label" for="nameFilter">بحث بالاسم</label><input class="form-control" id="nameFilter" name="name" value="@Model.Name" placeholder="اسم المستفيد"/></div><div class="col-md-4"><label class="form-label" for="statusFilter">حالة الاستلام</label><select class="form-select" id="statusFilter" name="status"><option value="all" selected="@(Model.Status == "all")">كل الحالات</option><option value="pending" selected="@(Model.Status == "pending")">لم يستلم</option><option value="received" selected="@(Model.Status == "received")">تم الاستلام</option></select></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-primary">تصفية السجلات</button><a asp-action="Details" asp-route-id="@batch.Id" class="btn btn-light">مسح</a></div></form>
<div class="d-flex flex-wrap gap-3 mb-3"><span class="legend"><i class="legend-dot pending-dot"></i>لم يستلم</span><span class="legend"><i class="legend-dot received-dot"></i>تم الاستلام</span></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0 review-table"><thead><tr><th>الرقم</th><th>رقم التسلسل</th><th>اسم المستفيد من البطاقة</th><th>الاسم على البطاقة</th><th>جزء من رقم البطاقة</th><th>جزء الرقم الوطني</th><th>ملاحظات</th><th>حالة الاستلام</th><th>الإجراءات</th></tr></thead><tbody>
@if (Model.Records.Count == 0) { <tr><td colspan="9" class="text-center py-4 text-muted">لا توجد سجلات مطابقة للفلاتر.</td></tr> }
@foreach (var record in Model.Records)
{
    <tr class="@(record.IsReceived ? "received-row" : "pending-row")"><td colspan="9">
        @if (canEdit)
        {
            <form asp-action="UpdateCard" method="post" class="review-row-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@record.Id"/><input type="hidden" name="BatchId" value="@batch.Id"/><input name="SourceRowNumber" class="form-control form-control-sm numeric-field" value="@record.SourceRowNumber" maxlength="20" aria-label="الرقم"/><input name="SerialNumber" class="form-control form-control-sm numeric-field" value="@record.SerialNumber" maxlength="40" aria-label="رقم التسلسل"/><input name="BeneficiaryName" class="form-control form-control-sm name-field" value="@record.BeneficiaryName" required maxlength="200" aria-label="اسم المستفيد من البطاقة"/><input name="CardName" class="form-control form-control-sm" value="@record.CardName" maxlength="200" aria-label="الاسم على البطاقة"/><input name="CardNumber" class="form-control form-control-sm numeric-field" value="@record.CardNumber" maxlength="40" aria-label="جزء من رقم البطاقة"/><input name="NationalNumber" class="form-control form-control-sm numeric-field" value="@record.NationalNumber" maxlength="32" aria-label="جزء الرقم الوطني"/><input name="Notes" class="form-control form-control-sm" value="@record.Notes" maxlength="500" aria-label="ملاحظات"/><span class="status-pill @(record.IsReceived ? "status-done" : "status-wait")">@(record.IsReceived ? "تم الاستلام" : "لم يستلم")</span><div class="d-flex flex-wrap gap-1"><button class="btn btn-sm btn-outline-primary">حفظ</button>@if (canReceive && !record.IsReceived && batch.IsReviewed) { <button formaction="@Url.Action("MarkReceived")" name="id" value="@record.Id" data-receipt-confirm data-beneficiary="@record.BeneficiaryName" data-serial="@(record.SerialNumber ?? "غير متوفر")" data-period="@batch.ValidityMonth/@batch.ValidityYear" class="btn btn-sm btn-success">تسجيل الاستلام</button> } else if (canReceive && !record.IsReceived) { <button type="button" class="btn btn-sm btn-success" disabled title="اعتمد الكشف أولًا">تسجيل الاستلام</button> } else if (canReceive && record.IsReceived) { <a asp-action="Receipt" asp-route-id="@record.Id" target="_blank" class="btn btn-sm btn-outline-secondary">طباعة الإيصال</a><button formaction="@Url.Action("UndoReceipt")" name="id" value="@record.Id" formnovalidate onclick="return confirm('هل تريد إلغاء تسجيل الاستلام؟')" class="btn btn-sm btn-outline-danger">إلغاء التسليم</button> }</div></form>
        }
        else
        {
            <div class="review-row-form"><span>@record.SourceRowNumber</span><span>@record.SerialNumber</span><span class="name-field">@record.BeneficiaryName</span><span>@record.CardName</span><span>@record.CardNumber</span><span>@record.NationalNumber</span><span>@record.Notes</span><span class="status-pill @(record.IsReceived ? "status-done" : "status-wait")">@(record.IsReceived ? "تم الاستلام" : "لم يستلم")</span><span>@if (canReceive && !record.IsReceived && batch.IsReviewed) { <form asp-action="MarkReceived" method="post" class="m-0">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@record.Id"/><button class="btn btn-sm btn-success" data-receipt-confirm data-beneficiary="@record.BeneficiaryName" data-serial="@(record.SerialNumber ?? "غير متوفر")" data-period="@batch.ValidityMonth/@batch.ValidityYear">تسجيل الاستلام</button></form> } else if (canReceive && record.IsReceived) { <a asp-action="Receipt" asp-route-id="@record.Id" target="_blank" class="btn btn-sm btn-outline-secondary">طباعة الإيصال</a><form asp-action="UndoReceipt" method="post" class="m-0" onsubmit="return confirm('هل تريد إلغاء تسجيل الاستلام؟')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@record.Id"/><button class="btn btn-sm btn-outline-danger">إلغاء التسليم</button></form> }</span></div>
        }
    </td></tr>
}
</tbody></table></div></div>
@if (canEdit) { <div class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h5">إضافة سجل لم يلتقطه OCR</h2><p class="text-muted small">أدخل بياناته تحت العناوين المطابقة لكشف الوزارة.</p><form asp-action="AddCard" method="post" class="row g-2 align-items-end">@Html.AntiForgeryToken()<input type="hidden" name="BatchId" value="@batch.Id"/><div class="col-md-2"><label class="form-label">الرقم</label><input name="SourceRowNumber" class="form-control" maxlength="20"/></div><div class="col-md-2"><label class="form-label">رقم التسلسل</label><input name="SerialNumber" class="form-control" maxlength="40"/></div><div class="col-md-3"><label class="form-label">اسم المستفيد من البطاقة</label><input name="BeneficiaryName" class="form-control" required maxlength="200"/></div><div class="col-md-3"><label class="form-label">الاسم على البطاقة</label><input name="CardName" class="form-control" maxlength="200"/></div><div class="col-md-2"><label class="form-label">جزء من رقم البطاقة</label><input name="CardNumber" class="form-control" maxlength="40"/></div><div class="col-md-3"><label class="form-label">جزء الرقم الوطني</label><input name="NationalNumber" class="form-control" maxlength="32"/></div><div class="col-md-6"><label class="form-label">ملاحظات</label><input name="Notes" class="form-control" maxlength="500"/></div><div class="col-md-3"><button class="btn btn-primary w-100">إضافة السجل</button></div></form></div></div> }
@if (canApprove && !batch.IsReviewed && batch.Records.Count > 0) { <form asp-action="Approve" method="post" class="mt-4">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@batch.Id"/><button class="btn btn-success btn-lg">اعتماد الكشف وإتاحته للمواطنين</button></form> }
@if (batch.IsReviewed) { <div class="alert alert-success mt-4 mb-0">الكشف معتمد ويظهر في نتائج البحث.</div> }
@section Scripts {
<script>
document.addEventListener('click', event => {
    const button = event.target.closest('[data-receipt-confirm]');
    if (!button) return;
    const message = `تأكيد تسجيل استلام البطاقة؟\nالمستفيد: ${button.dataset.beneficiary}\nرقم التسلسل: ${button.dataset.serial}\nالفترة: ${button.dataset.period}`;
    if (!window.confirm(message)) { event.preventDefault(); event.stopImmediatePropagation(); }
});
</script>
}
