@model BenefitCardsPortal.Models.DeliveryReportViewModel
@{ Layout = null; }
<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>تقرير التسليمات - @Model.Month/@Model.Year</title><style>
body{font-family:Arial,sans-serif;color:#172b3a;margin:24px}h1{margin:0 0 8px}.meta{color:#526576;margin-bottom:20px}.stats{display:flex;gap:16px;margin:18px 0}.stats div{border:1px solid #dce5eb;padding:10px 16px;border-radius:8px;min-width:130px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{border:1px solid #cbd5dc;padding:7px;text-align:right}th{background:#eef3f6}.received{background:#eef8f0}.actions{margin-bottom:18px}@@media print{body{margin:8mm}.actions{display:none}thead{display:table-header-group}tr{page-break-inside:avoid}}
</style></head><body><div class="actions"><button onclick="window.print()">طباعة / حفظ PDF</button></div><h1>تقرير التسليمات والتراجعات</h1><div class="meta">فرع قصر خيار · الكشوف المعتمدة · الفترة: @(Model.Month?.ToString() ?? "كل الأشهر") / @(Model.Year?.ToString() ?? "كل السنوات") · الحالة: @(Model.Status == "received" ? "تم الاستلام" : Model.Status == "pending" ? "لم يستلم" : "الكل")</div>
<div class="stats"><div>إجمالي السجلات: <b>@Model.TotalCount</b></div><div>تم الاستلام: <b>@Model.ReceivedCount</b></div><div>لم يستلم: <b>@Model.PendingCount</b></div><div>عمليات التراجع: <b>@Model.ReversalCount</b></div></div>@if(Model.MatchingCount > 5000){<p>تم عرض أول 5,000 من @Model.MatchingCount سجلًا مطابقًا؛ ضيّق عوامل التصفية لطباعة جميع النتائج.</p>}
<table><thead><tr><th>المستفيد</th><th>رقم التسلسل</th><th>جزء من رقم البطاقة</th><th>الفترة</th><th>الحالة</th><th>الموظف</th><th>وقت التسليم</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr class="@(row.IsReceived ? "received" : "")"><td>@row.BeneficiaryName</td><td>@(row.SerialNumber ?? "—")</td><td>@(row.CardNumber ?? "—")</td><td>@row.Month/@row.Year</td><td>@(row.IsReceived ? "تم الاستلام" : "لم يستلم")</td><td>@(row.ReceivedBy ?? "—")</td><td>@(row.ReceivedAtLocal?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td></tr>}</tbody></table>
<script>window.addEventListener('load',()=>setTimeout(()=>window.print(),250));</script></body></html>
