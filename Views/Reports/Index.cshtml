@model BenefitCardsPortal.Models.DeliveryReportViewModel
@{ ViewData["Title"] = "تقرير التسليمات"; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><span class="eyebrow">متابعة أداء الفرع</span><h1 class="h2 mb-1">تقرير التسليمات والتراجعات</h1><p class="text-muted mb-0">يعرض الكشوف المعتمدة فقط، ولا يتضمن الرقم الوطني.</p></div>
    <div class="d-flex gap-2"><a asp-action="DownloadCsv" asp-route-month="@Model.Month" asp-route-year="@Model.Year" asp-route-status="@Model.Status" class="btn btn-outline-success">تنزيل Excel (CSV)</a><a asp-action="Print" asp-route-month="@Model.Month" asp-route-year="@Model.Year" asp-route-status="@Model.Status" target="_blank" class="btn btn-primary">طباعة / حفظ PDF</a></div>
</div>
<form method="get" asp-action="Index" class="filter-panel row g-2 align-items-end mb-3">
    <div class="col-sm-4 col-lg-3"><label class="form-label" for="month">شهر الصلاحية</label><select id="month" name="month" class="form-select"><option value="">كل الأشهر</option>@for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(Model.Month == m)">@m</option> }</select></div>
    <div class="col-sm-4 col-lg-3"><label class="form-label" for="year">السنة</label><select id="year" name="year" class="form-select"><option value="">كل السنوات</option>@foreach (var y in Model.Years) { <option value="@y" selected="@(Model.Year == y)">@y</option> }</select></div>
    <div class="col-sm-4 col-lg-3"><label class="form-label" for="status">حالة الاستلام</label><select id="status" name="status" class="form-select"><option value="all" selected="@(Model.Status == "all")">الكل</option><option value="received" selected="@(Model.Status == "received")">تم الاستلام</option><option value="pending" selected="@(Model.Status == "pending")">لم يستلم</option></select></div>
    <div class="col-lg-3 d-flex gap-2"><button class="btn btn-primary">تصفية التقرير</button><a asp-action="Index" class="btn btn-light">مسح</a></div>
</form>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="stat-card stat-violet"><span>إجمالي السجلات</span><strong>@Model.TotalCount</strong><small>حسب الفلاتر المختارة</small></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card stat-green"><span>تم الاستلام</span><strong>@Model.ReceivedCount</strong><small>بطاقات مسلّمة</small></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card stat-amber"><span>لم يستلم</span><strong>@Model.PendingCount</strong><small>بطاقات متبقية</small></div></div>
    <div class="col-6 col-xl-3"><div class="stat-card stat-blue"><span>عمليات التراجع</span><strong>@Model.ReversalCount</strong><small>إلغاء تسجيل استلام</small></div></div>
</div>
<div class="search-result-count mb-3"><span>السجلات المطابقة @if (Model.MatchingCount > 5000) { <text>(المعروض أول 5,000)</text> }</span><strong>@Model.Rows.Count / @Model.MatchingCount</strong></div>
@if (Model.MatchingCount > 5000) { <div class="alert alert-info">النتائج كبيرة؛ استخدم فلاتر الشهر والسنة لتضييق التقرير. تعرض الشاشة والتنزيل أول 5,000 سجل.</div> }
<section class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>المستفيد</th><th>رقم التسلسل</th><th>جزء من رقم البطاقة</th><th>الفترة</th><th>الحالة</th><th>الموظف</th><th>وقت التسليم</th></tr></thead><tbody>
@if (Model.Rows.Count == 0) { <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد سجلات مطابقة.</td></tr> }
@foreach (var row in Model.Rows) { <tr class="@(row.IsReceived ? "table-success" : "")"><td class="fw-semibold">@row.BeneficiaryName</td><td>@(row.SerialNumber ?? "—")</td><td>@(row.CardNumber ?? "—")</td><td>@row.Month/@row.Year</td><td><span class="status-pill @(row.IsReceived ? "status-done" : "status-wait")">@(row.IsReceived ? "تم الاستلام" : "لم يستلم")</span></td><td>@(row.ReceivedBy ?? "—")</td><td>@(row.ReceivedAtLocal?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td></tr> }
</tbody></table></div></section>
