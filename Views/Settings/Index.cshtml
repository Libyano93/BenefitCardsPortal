@model BenefitCardsPortal.Models.AuditSettingsViewModel
@{ ViewData["Title"] = "إعدادات النظام"; }
<div class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-3"><div><span class="eyebrow">إعدادات المسؤول</span><h1 class="h2">التنبيهات والاحتفاظ بسجل العمليات</h1><p class="text-muted mb-0">يُفحص سجل العمليات كل دقيقة؛ ويحذف النظام ما تجاوز مدة الاحتفاظ بعد إرسال التنبيه.</p></div><div class="d-flex flex-wrap gap-2"><a asp-action="Email" class="btn btn-outline-primary btn-lg">✉ إعدادات البريد</a><a asp-action="Backup" class="btn btn-outline-success btn-lg">نسخ قاعدة البيانات</a></div></div>
@if (Model.SmtpConfigured) { <div class="alert alert-success">خادم SMTP مهيأ. ستصل إشعارات الحذف إلى البريد المحدد في إعدادات البريد.</div> } else { <div class="alert alert-warning"><strong>خادم البريد غير مهيأ حاليًا.</strong> لن يحذف النظام أي سجل حتى ينجح إرسال التنبيه. افتح إعدادات البريد لإدخال بيانات خادم SMTP.</div> }
<section class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Index" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="form-check form-switch mb-4"><input asp-for="CleanupEnabled" class="form-check-input"/><label asp-for="CleanupEnabled" class="form-check-label fw-bold">تفعيل المسح التلقائي لسجل العمليات</label><div class="form-text">عند الإيقاف تبقى سجلات العمليات محفوظة ولا تُحذف.</div></div>
    <input asp-for="NotificationEmail" type="hidden"/><div class="row g-3"><div class="col-md-6"><label asp-for="RetentionAmount" class="form-label">مدة الاحتفاظ</label><input asp-for="RetentionAmount" class="form-control" type="number" min="1"/><span asp-validation-for="RetentionAmount" class="text-danger"></span></div><div class="col-md-6"><label asp-for="RetentionUnit" class="form-label">وحدة المدة</label><select asp-for="RetentionUnit" class="form-select"><option value="days">أيام</option><option value="hours">ساعات</option></select><span asp-validation-for="RetentionUnit" class="text-danger"></span></div></div>
    <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">حفظ الإعدادات</button><a asp-controller="Employee" asp-action="Audit" class="btn btn-light">العودة لسجل العمليات</a></div>
</form></div></section>
