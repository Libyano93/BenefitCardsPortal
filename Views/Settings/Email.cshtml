@model BenefitCardsPortal.Models.EmailSettingsViewModel
@{ ViewData["Title"] = "إعدادات البريد"; }
<div class="page-heading d-flex flex-wrap align-items-center justify-content-between gap-3"><div><span class="eyebrow">إعدادات المسؤول</span><h1 class="h2 mb-1">إعدادات البريد الإلكتروني</h1><p class="text-muted mb-0">أدخل خادم SMTP ثم أرسل رسالة تجريبية قبل تفعيل تنبيهات الحذف.</p></div><a asp-action="Index" class="btn btn-light">العودة إلى الإعدادات</a></div>
@if (Model.SmtpConfigured) { <div class="alert alert-success">إعداد SMTP مكتمل. أرسل رسالة تجريبية للتحقق من وصول البريد.</div> } else { <div class="alert alert-warning">أدخل بيانات خادم البريد والمرسل. إذا كان الخادم يتطلب مصادقة، أدخل اسم المستخدم وكلمة المرور.</div> }
@if (Model.EnvironmentOverrides) { <div class="alert alert-info">توجد أيضًا متغيرات SMTP في بيئة التشغيل. القيم التي تحفظها من هذه الشاشة تتقدم عليها، وتستخدم متغيرات التشغيل عند ترك الحقول غير محفوظة.</div> }
<section class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Email" method="post" class="email-settings-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="Host" class="form-label">خادم SMTP</label><input asp-for="Host" class="form-control" dir="ltr" placeholder="smtp.example.org" autocomplete="off"/><span asp-validation-for="Host" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Port" class="form-label">المنفذ</label><input asp-for="Port" class="form-control" type="number" min="1" max="65535" dir="ltr"/><span asp-validation-for="Port" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="FromAddress" class="form-label">عنوان المرسل</label><input asp-for="FromAddress" class="form-control" type="email" dir="ltr" placeholder="portal@example.org" autocomplete="off"/><span asp-validation-for="FromAddress" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="NotificationEmail" class="form-label">عنوان استقبال التنبيهات</label><input asp-for="NotificationEmail" class="form-control" type="email" dir="ltr"/><span asp-validation-for="NotificationEmail" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="UserName" class="form-label">اسم مستخدم SMTP <span class="text-muted fw-normal">(اختياري)</span></label><input asp-for="UserName" class="form-control" dir="ltr" autocomplete="off"/><span asp-validation-for="UserName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Password" class="form-label">كلمة مرور SMTP</label><input asp-for="Password" class="form-control" type="password" dir="ltr" autocomplete="new-password" placeholder="@(Model.HasSavedPassword ? "محفوظة؛ اتركه فارغًا للإبقاء عليها" : "تُحفظ مشفّرة")"/><span asp-validation-for="Password" class="text-danger"></span>@if (Model.HasSavedPassword) { <div class="form-text text-success">توجد كلمة مرور محفوظة ومحمية؛ لا نعرضها هنا.</div> }</div>
    </div>
    <div class="row g-3 mt-1"><div class="col-md-6"><div class="form-check form-switch"><input asp-for="EnableSsl" class="form-check-input"/><label asp-for="EnableSsl" class="form-check-label fw-bold">استخدام اتصال SSL/TLS</label></div></div><div class="col-md-6"><div class="form-check"><input asp-for="ClearPassword" class="form-check-input"/><label asp-for="ClearPassword" class="form-check-label">مسح كلمة المرور المحفوظة</label></div></div></div>
    <div class="email-security-note mt-4"><strong>حماية كلمة المرور</strong><p class="mb-0">تُحفظ كلمة المرور مشفّرة بحماية التطبيق، ولا تظهر بعد الحفظ. اترك الحقل فارغًا للاحتفاظ بكلمة المرور الحالية. لخادم الإرسال الداخلي دون مصادقة، اترك اسم المستخدم وكلمة المرور فارغين.</p></div>
    <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary" name="sendTest" value="false">حفظ الإعدادات</button><button type="submit" class="btn btn-success" name="sendTest" value="true">حفظ وإرسال رسالة تجريبية</button><a asp-action="Index" class="btn btn-light">إلغاء</a></div>
</form></div></section>
