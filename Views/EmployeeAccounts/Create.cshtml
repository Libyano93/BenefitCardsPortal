@model BenefitCardsPortal.Models.RegisterEmployeeViewModel
@{ ViewData["Title"] = "تسجيل موظف"; }
<div class="page-heading"><span class="eyebrow">حساب موظف جديد</span><h1 class="h2">تسجيل موظف</h1><p class="text-muted">أدخل البريد وكلمة مرور أولية، ثم أعط الموظف بيانات الدخول بطريقة آمنة.</p></div>
<section class="card form-card border-0 shadow-sm"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="DisplayName" class="form-label">اسم الموظف</label><input asp-for="DisplayName" class="form-control" autocomplete="name"/><span asp-validation-for="DisplayName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label">البريد الإلكتروني لتسجيل الدخول</label><input asp-for="Email" class="form-control" type="email" dir="ltr" autocomplete="username"/><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">كلمة مرور أولية</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><div class="form-text">10 أحرف على الأقل، وتتبع كلمة المرور سياسة النظام.</div><span asp-validation-for="Password" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <div class="mb-3 form-check form-switch"><input asp-for="IsAdmin" class="form-check-input"/><label asp-for="IsAdmin" class="form-check-label fw-bold">مسؤول النظام (صلاحيات كاملة)</label><div class="form-text">فعّلها فقط لمن يحتاج إدارة حسابات الموظفين وإعدادات النظام.</div></div>
    <fieldset class="mb-4"><legend class="form-label">صلاحيات الموظف</legend><p class="form-text">حدد الإجراءات التي يسمح لهذا الموظف بتنفيذها. يمكنه رؤية لوحة الموظف حتى دون صلاحيات تنفيذية.</p><div class="row g-2">@foreach (var permission in BenefitCardsPortal.Security.EmployeePermissionCatalog.Options) { <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="Permissions" value="@permission.Role" checked="@(Model.Permissions.Contains(permission.Role))"/><label class="form-check-label">@permission.Label</label></div></div> }</div></fieldset>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">إنشاء الحساب</button><a asp-action="Index" class="btn btn-light">إلغاء</a></div>
</form></section>
