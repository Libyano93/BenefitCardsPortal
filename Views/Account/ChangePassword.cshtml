@model BenefitCardsPortal.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "تغيير كلمة المرور"; }
<section class="auth-card password-card mx-auto">
    <div class="text-center mb-4">
        <span class="password-shield" aria-hidden="true">🔐</span>
        <span class="eyebrow d-block mt-3">خطوة أمان مطلوبة</span>
        <h1 class="h3 mt-2">غيّر كلمة المرور المؤقتة</h1>
        <p class="text-muted mb-0">أنشئ كلمة مرور جديدة قبل متابعة استخدام لوحة الموظف.</p>
    </div>
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">كلمة المرور الحالية</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">كلمة المرور الجديدة</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><div class="form-text">10 أحرف على الأقل، وتشمل رقمًا وحرفًا كبيرًا.</div><span asp-validation-for="NewPassword" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور الجديدة</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button class="btn btn-primary w-100">حفظ كلمة المرور والمتابعة</button>
    </form>
</section>
